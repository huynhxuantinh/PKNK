DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ADMIN_PATH=admin
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=pknk
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_HOST_PORT=5433
WEB_PORT=8000

GIS_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\18\bin\libgdal-35.dll
GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\18\bin\libgeos_c.dll

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
DRF_NUM_PROXIES=1
MAX_ACTIVE_HOLDS_PER_PATIENT=3
PRIVACY_POLICY_VERSION=1.0

FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DentaVie <contact@dentavie.id.vn>
EMAIL_HOST=mail.dentavie.id.vn
EMAIL_PORT=587
EMAIL_HOST_USER=contact@dentavie.id.vn
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

MINIO_ROOT_USER=pknk_minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_BUCKET=pknk-clinical
CLINICAL_ATTACHMENT_MAX_BYTES=15728640

PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
PAYOS_RETURN_URL=http://localhost:5173/hoa-don/ket-qua
PAYOS_CANCEL_URL=http://localhost:5173/hoa-don?huy=1

