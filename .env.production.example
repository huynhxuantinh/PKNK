APP_VERSION=2026.10.26
SITE_ADDRESS=dentavie.example.com

DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ADMIN_PATH=replace-with-random-admin-path
DJANGO_ALLOWED_HOSTS=dentavie.example.com,127.0.0.1,web
FRONTEND_URL=https://dentavie.example.com
DRF_NUM_PROXIES=1

DB_NAME=pknk
DB_USER=pknk
DB_PASSWORD=replace-with-a-long-random-postgres-password

CELERY_WORKER_CONCURRENCY=2
MAX_ACTIVE_HOLDS_PER_PATIENT=3
PRIVACY_POLICY_VERSION=1.0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=DentaVie <contact@dentavie.example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=contact@dentavie.example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-secret
MINIO_BUCKET=pknk-clinical
CLINICAL_ATTACHMENT_MAX_BYTES=15728640

PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
PAYOS_RETURN_URL=https://dentavie.example.com/hoa-don/ket-qua
PAYOS_CANCEL_URL=https://dentavie.example.com/hoa-don?huy=1
